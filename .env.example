# Anthropic — Sonnet for generation, Haiku reserved for Phase 2 routing
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATION_MODEL=claude-sonnet-4-20250514
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Voyage AI embeddings
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5
VOYAGE_EMBED_DIM=1024

# Pinecone serverless
PINECONE_API_KEY=
PINECONE_INDEX_NAME=golf-ai-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Retrieval
RETRIEVE_TOP_K=6
RETRIEVE_MIN_SCORE=0.25

# App
APP_ENV=development
LOG_LEVEL=INFO
